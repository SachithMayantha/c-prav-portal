age":"125","line":567,"column":61,"nodeType":"126","endLine":567,"endColumn":136},{"ruleId":"124","severity":1,"message":"125","line":568,"column":61,"nodeType":"126","endLine":568,"endColumn":130},{"ruleId":"124","severity":1,"message":"125","line":576,"column":61,"nodeType":"126","endLine":576,"endColumn":128},{"ruleId":"124","severity":1,"message":"125","line":587,"column":61,"nodeType":"126","endLine":587,"endColumn":136},{"ruleId":"124","severity":1,"message":"125","line":588,"column":61,"nodeType":"126","endLine":588,"endColumn":130},{"ruleId":"124","severity":1,"message":"125","line":596,"column":61,"nodeType":"126","endLine":596,"endColumn":128},{"ruleId":"124","severity":1,"message":"125","line":607,"column":61,"nodeType":"126","endLine":607,"endColumn":136},{"ruleId":"124","severity":1,"message":"125","line":608,"column":61,"nodeType":"126","endLine":608,"endColumn":130},{"ruleId":"124","severity":1,"message":"125","line":616,"column":61,"nodeType":"126","endLine":616,"endColumn":128},{"ruleId":"128","severity":1,"message":"129","line":11,"column":33,"nodeType":"126","endLine":11,"endColumn":124},"jsx-a11y/anchor-is-valid","The href attribute requires a valid value to be accessible. Provide a valid, navigable address as the href value. If you cannot provide a valid href, but still need the element to resemble a link, use a button and change it with appropriate styles. Learn more: https://github.com/jsx-eslint/eslint-plugin-jsx-a11y/blob/HEAD/docs/rules/anchor-is-valid.md","JSXOpeningElement","The href attribute is required for an anchor to be keyboard accessible. Provide a valid, navigable address as the href value. If you cannot provide an href, but still need the element to resemble a link, use a button and change it with appropriate styles. Learn more: https://github.com/jsx-eslint/eslint-plugin-jsx-a11y/blob/HEAD/docs/rules/anchor-is-valid.md","jsx-a11y/img-redundant-alt","Redundant alt attribute. Screen-readers already announce `img` tags as an image. You don’t need to use the words `image`, `photo,` or `picture` (or any specified custom words) in the alt prop.","jsx-a11y/role-has-required-aria-props","Elements with the ARIA role \"combobox\" must have the following attributes defined: aria-controls,aria-expanded","JSXAttribute"]